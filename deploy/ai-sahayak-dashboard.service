[Unit]
Description=AI Sahayak Dashboard API (Flask :8001)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/ai-sahayak/app/Dashboard
EnvironmentFile=-/home/ec2-user/ai-sahayak/app/Dashboard/.env
ExecStart=/home/ec2-user/ai-sahayak/app/Dashboard/.venv/bin/python app.py --mode api --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
