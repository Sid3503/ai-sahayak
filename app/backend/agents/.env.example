### 🚨 UTMOST NECESSARY (Minimal Agent Run) 🚨

# 1. AI / LLM Configuration (The "Brain")
# Since we use AWS Bedrock as the default orchestrator
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
BEDROCK_REGION="ap-south-1"
# Optional: override LLM (default in code is amazon.nova-lite-v1:0 for EC2 compatibility)
# DEFAULT_MODEL_ID="amazon.nova-lite-v1:0"
# REASONING_MODEL_ID="amazon.nova-lite-v1:0"

# 2. Database Configuration (The "Memory")
# Necessary for LangGraph to save conversation state and session history
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="ai_sahayak"

# 3. Cognito (Dashboard login = same User ID/Password from onboarding chat)
# Use the same User pool as frontend (VITE_COGNITO_USER_POOL_ID).
# Get Pool ID from: Cognito → User pools → your pool (e.g. kyc-yv) → User pool overview → "User pool ID".
# IAM: credentials must have cognito-idp:AdminCreateUser and AdminSetUserPassword on this pool.
COGNITO_USER_POOL_ID=ap-south-1_g1M7FbU0x


### 💡 OPTIONAL / LATER 💡

# WhatsApp (Not needed for Frontend Chat UI)
# WHATSAPP_VERIFY_TOKEN="sahayak_secret"
# WHATSAPP_ACCESS_TOKEN="your_meta_access_token"

# Observability (Recommended for debugging)
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="your_api_key"

# Translation (Needed for multi-lingual test)
# BHASHINI_API_KEY="your_bhashini_api_key"

# Transcribe (voice messages in onboarding WP UI)
# S3 bucket in same region; IAM needs transcribe:* and s3:PutObject/GetObject/DeleteObject on this bucket.
# TRANSCRIBE_MEDIA_BUCKET=ai-sahayak-transcribe-ap-south-1
