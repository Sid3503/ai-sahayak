# Backend agents API base URL (your friend's backend).
# Onboard chat sends messages to: {VITE_AGENT_API_BASE}/v1/webhook/incoming
# If unset, defaults to http://localhost:8000
VITE_AGENT_API_BASE=http://localhost:8000

# AWS Cognito User Pool config (frontend only – no backend changes)
# Ask your friend / AWS console for real values before using login.
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=your_user_pool_id
VITE_COGNITO_USER_POOL_CLIENT_ID=your_user_pool_app_client_id

# Control Centre (friend's Dashboard – Dynamic Price Simulator). Shown after sign-in.
# Run that app with: cd app/Dashboard && npm run dev (often http://localhost:5173 or 5175)
VITE_CONTROL_CENTRE_URL=http://localhost:5175

# Optional: OIDC config for hosted UI login (Cognito)
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_g1M7FbU0x
VITE_COGNITO_CLIENT_ID=3aiio9gu0q1j55luime7o03k5j
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
