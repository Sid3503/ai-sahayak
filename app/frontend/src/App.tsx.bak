import { useEffect, useRef, useState } from 'react'
import './App.css'
import { useAuth } from './authContext'
import { signIn, getCurrentUser } from 'aws-amplify/auth'
import { isCognitoConfigured } from './cognitoConfig'
import { FESTIVAL_CALENDAR, FESTIVAL_ALERT_DAYS } from './constants'

function useInView(threshold = 0.12) {
  const ref = useRef<HTMLDivElement>(null)
  const [, setInView] = useState(false)
  const [hasSeen, setHasSeen] = useState(false)
  useEffect(() => {
    const el = ref.current
    if (!el) return
    const obs = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) setHasSeen(true)
        setInView(e.isIntersecting)
      },
      { threshold }
    )
    obs.observe(el)
    return () => obs.disconnect()
  }, [threshold])
  return [ref, hasSeen] as const
}

const JOURNEY_STEPS = [
  { id: 'landing' as const, num: 1, label: 'Home', short: 'Home' },
  { id: 'chat' as const, num: 2, label: "Raju's onboarding", short: 'Onboard' },
  { id: 'dashboard' as const, num: 3, label: 'Dashboard', short: 'Dashboard' },
  { id: 'day' as const, num: 4, label: "Raju's day", short: 'Day' },
]

type View = (typeof JOURNEY_STEPS)[number]['id']

function App() {
  const auth = useAuth()
  const [view, setView] = useState<View>('landing')
  const [logoCardOpen, setLogoCardOpen] = useState(false)
  const [dashboardLoggedIn, setDashboardLoggedIn] = useState(false)
  const [currentUsername, setCurrentUsername] = useState<string | null>(null)
  const currentStep = JOURNEY_STEPS.findIndex((s) => s.id === view) + 1

  // If Cognito is configured, check for existing Amplify session and get username (so refresh keeps user logged in)
  useEffect(() => {
    if (!isCognitoConfigured) return
    getCurrentUser()
      .then((user) => {
        setDashboardLoggedIn(true)
        setCurrentUsername(user.username)
      })
      .catch(() => {})
  }, [])

  const isAuthenticatedForDashboard = auth.isAuthenticated || dashboardLoggedIn

  // Basic wiring for backend agent webhook; adjust base URL via Vite env if needed.
  const agentApiBase =
    (import.meta as any).env?.VITE_AGENT_API_BASE || 'http://localhost:8000'

  const handleOnboardingBotReply: OnboardingBotReply = async (userMessage: string) => {
    try {
      const response = await fetch(`${agentApiBase}/v1/webhook/incoming`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          user_id: 'demo-user',
          text: userMessage,
          platform: 'web',
          phone_number: '0000000000',
          session_id: 'demo-session',
        }),
      })

      if (!response.ok) {
        console.error('Agent API error status', response.status)
        return 'Bot is unavailable right now. Please try again.'
      }

      const data = await response.json()
      return data.reply || data.message || 'No reply from bot.'
    } catch (error) {
      console.error('Error calling agent API', error)
      return 'Unable to reach the bot. Please check the server.'
    }
  }

  const handleOnboardingImageUpload: OnboardingImageUpload = async (base64: string, mimeType: string) => {
    try {
      const response = await fetch(`${agentApiBase}/v1/webhook/incoming`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_id: 'demo-user',
          text: 'Photo attached',
          image: base64,
          image_media_type: mimeType,
          platform: 'web',
          phone_number: '0000000000',
          session_id: 'demo-session',
        }),
      })
      if (!response.ok) return 'Photo received. You can send more or type a message.'
      const data = await response.json()
      return data.reply || data.message || 'Photo received.'
    } catch {
      return 'Could not upload photo. Please try again.'
    }
  }

  const handleOnboardingVoiceMessage: OnboardingVoiceMessage = async (audioBase64: string, mimeType: string) => {
    try {
      const response = await fetch(`${agentApiBase}/v1/webhook/incoming`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_id: 'demo-user',
          audio: audioBase64,
          audio_media_type: mimeType,
          platform: 'web',
          phone_number: '0000000000',
          session_id: 'demo-session',
          metadata: { voice_language: 'hi' },
        }),
      })
      if (!response.ok) {
        const err = await response.json().catch(() => ({}))
        return { reply: err.detail || 'Voice not available. Please type your message.', transcribed_text: undefined }
      }
      const data = await response.json()
      return { reply: data.reply || '', transcribed_text: data.transcribed_text }
    } catch (e) {
      console.error('Voice webhook error', e)
      return { reply: 'Unable to reach the bot. Please try again.', transcribed_text: undefined }
    }
  }

  return (
    <div className="min-h-screen text-slate-900">
      {logoCardOpen && (
        <>
          <button
            type="button"
            className="fixed inset-0 z-40 cursor-default bg-black/25"
            aria-label="Close"
            onClick={() => setLogoCardOpen(false)}
          />
          <div className="fixed left-8 top-28 z-50 w-[calc(100%-4rem)] max-w-sm rounded-2xl border border-slate-200 bg-white p-5 shadow-xl md:left-12 md:top-32 md:max-w-md md:p-6" role="dialog" aria-labelledby="logo-card-title">
            <div className="flex items-start justify-between gap-3">
              <div className="flex h-24 w-24 shrink-0 overflow-hidden rounded-2xl border-2 border-slate-200 md:h-28 md:w-28">
                <img src="/Generated_image.png" alt="AI Sahayak logo" className="h-full w-full object-contain" />
              </div>
              <button type="button" onClick={() => setLogoCardOpen(false)} className="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600" aria-label="Close">✕</button>
            </div>
            <h2 id="logo-card-title" className="mt-3 text-lg font-bold text-slate-900">Why this logo?</h2>
            <p className="mt-2 text-sm leading-relaxed text-slate-600">
              Green and amber reflect Bharat—growth and trust. The mark stands for <strong>Sahayak</strong>: a quiet co-pilot for Bharat&apos;s shops, summarising the day and flagging nearby events just in time.
            </p>
            <p className="mt-2 text-sm text-slate-500">
              Click anywhere outside to close.
            </p>
          </div>
        </>
      )}

      <div className="mx-auto flex min-h-screen max-w-7xl flex-col gap-4 rounded-[2.2rem] border border-slate-200/90 bg-gradient-to-br from-emerald-50 via-white to-amber-50 px-4 py-4 shadow-[0_24px_80px_-32px_rgba(15,23,42,0.55)] md:gap-6 md:px-8 md:py-6">
        <header className="sticky top-3 z-20 animate-fade-in">
          <div
            className="relative flex flex-col gap-4 overflow-hidden rounded-2xl border border-slate-200/90 bg-gradient-to-br from-slate-50/95 via-white/90 to-slate-100/95 px-4 py-3 shadow-[0_4px_24px_-4px_rgba(15,23,42,0.12),0_0_0_1px_rgba(15,23,42,0.04)] backdrop-blur-md transition-shadow duration-300 hover:shadow-[0_8px_32px_-6px_rgba(15,23,42,0.14)] md:flex-row md:items-center md:justify-between md:rounded-3xl md:px-6 md:py-4"
            style={{ animationDelay: '0ms', animationFillMode: 'forwards' }}
          >
            {/* Subtle gradient accent line */}
            <div className="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-emerald-300/60 to-transparent" aria-hidden />
            <div className="flex w-fit items-center gap-3">
              <button
                type="button"
                onClick={() => setLogoCardOpen(true)}
                className="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-all duration-300 hover:scale-105 hover:border-emerald-300 hover:shadow-md hover:ring-2 hover:ring-emerald-200 md:h-10 md:w-10 md:rounded-2xl active:scale-95"
                aria-label="About the logo"
              >
                <img src="/Generated_image.png" alt="AI Sahayak logo" className="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105" />
              </button>
              <button
                type="button"
                onClick={() => setView('landing')}
                className="rounded-xl text-left transition-all duration-200 hover:opacity-90 active:scale-[0.98]"
                aria-label="Go to Home"
              >
                <span className="bg-gradient-to-r from-slate-800 to-slate-700 bg-clip-text text-sm font-semibold tracking-tight text-transparent md:text-base">AI Sahayak</span>
              </button>
            </div>

            <div className="flex flex-wrap items-center justify-between gap-3 md:gap-4">
              <nav className="flex items-center gap-0 md:gap-1" aria-label="Journey steps">
              {JOURNEY_STEPS.map((step, i) => {
                const isActive = view === step.id
                const isPast = currentStep > step.num
                const showConnector = i < JOURNEY_STEPS.length - 1
                return (
                  <div key={step.id} className="flex flex-1 items-center md:flex-initial" style={{ animationDelay: `${(i + 1) * 50}ms` }}>
                    <button
                      type="button"
                      onClick={() => setView(step.id)}
                      className={`group flex flex-1 items-center justify-center gap-2 rounded-xl px-2 py-2.5 text-[0.7rem] font-medium transition-all duration-300 md:flex-initial md:gap-2.5 md:rounded-2xl md:px-4 md:py-2.5 md:text-[0.8rem] ${
                        isActive
                          ? 'animate-nav-glow bg-slate-900 text-white shadow-lg ring-2 ring-slate-900/80 ring-offset-2 ring-offset-slate-50'
                          : isPast
                            ? 'text-slate-600 hover:scale-[1.02] hover:bg-slate-100 hover:text-slate-900 hover:shadow-sm'
                            : 'text-slate-500 hover:scale-[1.02] hover:bg-slate-50 hover:text-slate-700 hover:shadow-sm'
                      }`}
                      title={step.label}
                    >
                      <span
                        className={`flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[0.7rem] font-bold transition-all duration-300 md:h-8 md:w-8 ${
                          isActive ? 'bg-white/25 text-white' : isPast ? 'bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200/50' : 'bg-slate-100 text-slate-400 group-hover:bg-slate-200/80'
                        }`}
                      >
                        {isPast ? '✓' : step.num}
                      </span>
                      <span className="hidden truncate lg:inline">{step.short}</span>
                    </button>
                    {showConnector && (
                      <div
                        className={`hidden h-1 w-5 flex-shrink-0 origin-left rounded-full md:block md:w-7 ${
                          isPast
                            ? 'animate-nav-connector bg-gradient-to-r from-emerald-400 to-emerald-500 shadow-[0_0_8px_rgba(52,211,153,0.5)]'
                            : 'bg-slate-200/80'
                        }`}
                        aria-hidden
                      />
                    )}
                  </div>
                )
              })}
              </nav>
              <div className="flex items-center gap-2">
                <span className="rounded-full border border-amber-200/80 bg-gradient-to-r from-amber-50 to-amber-100/80 px-2.5 py-1 text-[0.65rem] font-semibold text-amber-800 shadow-sm transition-all duration-300 hover:scale-105 hover:shadow-md md:px-3 md:py-1">
                  AWS AI for Bharat
                </span>
              </div>
            </div>
          </div>
        </header>

        {view === 'landing' && (
          <Landing
            onStart={() => setView('chat')}
            onSkipToDashboard={() => setView('dashboard')}
            onSkipToDay={() => setView('day')}
          />
        )}
        {view === 'chat' && (
          <ChatOnboarding
            onContinue={() => setView('dashboard')}
            onBotReply={handleOnboardingBotReply}
            onImageUpload={handleOnboardingImageUpload}
            onVoiceMessage={handleOnboardingVoiceMessage}
          />
        )}
        {view === 'dashboard' && (
          isAuthenticatedForDashboard ? (
            <Dashboard
              welcomeName={currentUsername}
              onBackToChat={() => setView('chat')}
              onToRajuDay={() => setView('day')}
            />
          ) : (
            <DashboardLoginCard
              title="Sign in"
              subtitle="Use the ID + password from your onboarding chat."
              onSuccess={(signedInUsername) => {
                setDashboardLoggedIn(true)
                setCurrentUsername(signedInUsername ?? null)
                getCurrentUser().then((user) => setCurrentUsername(user.username)).catch(() => {})
              }}
            />
          )
        )}
        {view === 'day' && (
          isAuthenticatedForDashboard ? (
            <RajuDay welcomeName={currentUsername} onBackToDashboard={() => setView('dashboard')} />
          ) : (
            <DashboardLoginCard
              title="Sign in"
              subtitle="Use the ID + password from your onboarding chat."
              onSuccess={(signedInUsername) => {
                setDashboardLoggedIn(true)
                setCurrentUsername(signedInUsername ?? null)
                getCurrentUser().then((user) => setCurrentUsername(user.username)).catch(() => {})
              }}
            />
          )
        )}
      </div>
    </div>
  )
}

function DashboardLoginCard({
  title,
  subtitle,
  onSuccess,
}: {
  title: string
  subtitle: string
  onSuccess: (signedInUsername?: string) => void
}) {
  const [username, setUsername] = useState('')
  const [password, setPassword] = useState('')
  const [error, setError] = useState('')
  const [loading, setLoading] = useState(false)

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault()
    setError('')
    if (!username.trim() || !password) {
      setError('Enter your ID and password.')
      return
    }
    if (!isCognitoConfigured) {
      setError('Cognito is not configured. Add VITE_COGNITO_* to .env.')
      return
    }
    setLoading(true)
    try {
      await signIn({ username: username.trim(), password })
      onSuccess(username.trim())
    } catch (err: unknown) {
      const message = err && typeof err === 'object' && 'message' in err ? String((err as { message: unknown }).message) : 'Sign-in failed.'
      setError(message)
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="flex flex-1 items-center justify-center">
      <div className="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <p className="text-center text-sm font-semibold text-slate-900">{title}</p>
        <p className="mt-2 text-center text-xs text-slate-600">{subtitle}</p>
        <form onSubmit={handleSubmit} className="mt-4 space-y-3">
          <input
            type="text"
            placeholder="User ID (or phone)"
            value={username}
            onChange={(e) => setUsername(e.target.value)}
            className="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
            autoComplete="username"
            disabled={loading}
          />
          <input
            type="password"
            placeholder="Password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            className="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
            autoComplete="current-password"
            disabled={loading}
          />
          {error && <p className="text-center text-xs text-red-600">{error}</p>}
          <button
            type="submit"
            disabled={loading}
            className="w-full rounded-full bg-slate-900 px-4 py-2.5 text-sm font-semibold text-slate-50 shadow-sm hover:bg-slate-800 disabled:opacity-60"
          >
            {loading ? 'Signing in…' : 'Sign in'}
          </button>
        </form>
      </div>
    </div>
  )
}

function Landing(props: { onStart: () => void; onSkipToDashboard: () => void; onSkipToDay: () => void }) {
  const { onStart, onSkipToDashboard, onSkipToDay } = props
  const [heroRef, heroSeen] = useInView(0.2)
  const [journeyRef, journeySeen] = useInView(0.15)
  const [storyRef, storySeen] = useInView(0.08)
  const [whyRef, whySeen] = useInView(0.08)
  const [choseRef, choseSeen] = useInView(0.08)
  const [impactRef, impactSeen] = useInView(0.08)
  const [ctaRef, ctaSeen] = useInView(0.2)

  return (
    <main className="flex flex-1 flex-col overflow-x-hidden">
      {/* —— HERO —— */}
      <section
        ref={heroRef}
        className={`relative min-h-[88vh] flex flex-col justify-center px-4 py-20 md:py-28 transition-all duration-700 ${heroSeen ? 'opacity-100' : 'opacity-0 translate-y-8'}`}
      >
        <div className="absolute inset-0 bg-gradient-to-br from-emerald-50/90 via-white to-amber-50/70 bg-gradient-move animate-gradient-shift pointer-events-none" />
        <div className="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(34,197,94,0.12),transparent)] pointer-events-none" />
        <div className="relative z-10 mx-auto max-w-4xl text-center">
          <p className="mb-5 text-[0.7rem] font-semibold uppercase tracking-[0.35em] text-emerald-600">AWS AI for Bharat · Professional Track</p>
          <h1 className="text-4xl font-extrabold leading-[1.08] tracking-tight text-slate-900 md:text-6xl lg:text-7xl">
            From{' '}
            <span className="text-slate-400 line-through decoration-2">reactive</span>
            <br />
            to{' '}
            <span className="bg-gradient-to-r from-sahayak-green via-emerald-500 to-sahayak-amber bg-clip-text text-transparent drop-shadow-sm">
              life-driven
            </span>
            .
          </h1>
          <p className="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl">
            What if every Raju Bhai had an AI that watched his daily sales and nearby events—before they turned into empty shelves?
          </p>
          <div className="mt-12 flex flex-wrap items-center justify-center gap-3">
            <span className="rounded-full border border-slate-200/90 bg-white/95 px-5 py-2.5 text-sm font-medium text-slate-700 shadow-sm backdrop-blur-sm transition hover:scale-105 hover:shadow-md">12–15M kirana stores</span>
            <span className="rounded-full border border-slate-200/90 bg-white/95 px-5 py-2.5 text-sm font-medium text-slate-700 shadow-sm backdrop-blur-sm transition hover:scale-105 hover:shadow-md">~₹15,000 lost per store when demand spikes</span>
            <span className="rounded-full bg-emerald-500/15 px-5 py-2.5 text-sm font-semibold text-emerald-800 shadow-sm transition hover:scale-105 hover:bg-emerald-500/20">Proactive intelligence, not guesswork</span>
          </div>
        </div>
        <div className="absolute bottom-8 left-1/2 -translate-x-1/2 animate-float text-slate-400">↓</div>
      </section>

      {/* —— JOURNEY IN 4 STEPS —— */}
      <section ref={journeyRef} className="border-t border-slate-200/80 bg-white/80 py-8 md:py-10">
        <div className="mx-auto max-w-5xl px-4">
          <p className="text-center text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Follow the demo</p>
          <div className="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
            {[
              { num: 1, title: 'Home', sub: 'Why we built this', ring: 'bg-slate-200 text-slate-600' },
              { num: 2, title: 'Onboarding', sub: 'Raju joins via WhatsApp', ring: 'bg-emerald-100 text-emerald-700' },
              { num: 3, title: 'Dashboard', sub: 'Command center', ring: 'bg-emerald-100 text-emerald-700' },
              { num: 4, title: "Raju's day", sub: 'Alerts & daily chat', ring: 'bg-emerald-100 text-emerald-700' },
            ].map((item, i) => (
              <div
                key={item.num}
                className={`rounded-2xl border border-slate-200 bg-slate-50/80 p-4 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg md:p-5 ${journeySeen ? 'animate-slide-up opacity-100' : 'opacity-0 translate-y-3'}`}
                style={{ animationDelay: journeySeen ? `${i * 80}ms` : undefined, animationFillMode: 'forwards' }}
              >
                <span className={`flex h-8 w-8 items-center justify-center rounded-full text-xs font-bold mx-auto transition transform hover:scale-110 ${item.ring}`}>{item.num}</span>
                <p className="mt-2 text-sm font-semibold text-slate-900">{item.title}</p>
                <p className="mt-0.5 text-[0.7rem] text-slate-500">{item.sub}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* —— THE STORY OF RAJU BHAI —— */}
      <section ref={storyRef} className="border-t border-slate-200/80 bg-slate-50/60 py-20 md:py-28">
        <div className={`mx-auto max-w-5xl px-4 transition-all duration-700 ${storySeen ? 'animate-fade-in-up opacity-100' : 'opacity-0 translate-y-6'}`}>
          <p className="text-center text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">The journey</p>
          <h2 className="mt-2 text-center text-3xl font-bold text-slate-900 md:text-4xl">The Story of Raju Bhai</h2>

          <div className="mt-16 grid gap-8 md:grid-cols-3">
            <div
              className={`rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xl shadow-slate-200/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl md:p-8 ${storySeen ? 'animate-slide-up opacity-100' : 'opacity-0 translate-y-4'}`}
              style={{ animationDelay: storySeen ? '0ms' : undefined, animationFillMode: 'forwards' }}
            >
              <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-2xl transition hover:scale-105">👤</div>
              <h3 className="mt-5 text-lg font-semibold text-slate-900">The character</h3>
              <p className="mt-2 text-sm leading-relaxed text-slate-600">
                Raju Bhai runs a mid-sized Kirana store in <strong>Indore</strong>. Hardworking, but overwhelmed—managing inventory by memory and a <strong>dusty notebook</strong>.
              </p>
            </div>
            <div
              className={`rounded-3xl border border-rose-200/90 bg-rose-50/60 p-7 shadow-xl shadow-rose-200/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-rose-200/40 md:p-8 ${storySeen ? 'animate-slide-up opacity-100' : 'opacity-0 translate-y-4'}`}
              style={{ animationDelay: storySeen ? '120ms' : undefined, animationFillMode: 'forwards' }}
            >
              <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-100 text-2xl transition hover:scale-105">⚠️</div>
              <h3 className="mt-5 text-lg font-semibold text-slate-900">The conflict</h3>
              <p className="mt-2 text-sm leading-relaxed text-slate-600">
                Last festive season he lost <strong className="text-rose-700">₹15,000</strong>. A local wedding season overlapped with the festival. He ran out of <strong>Mustard Oil & Ghee</strong> three days early—shelves empty, customers left disappointed.
              </p>
            </div>
            <div
              className={`rounded-3xl border border-emerald-200/90 bg-emerald-50/60 p-7 shadow-xl shadow-emerald-200/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-emerald-200/40 md:p-8 ${storySeen ? 'animate-slide-up opacity-100' : 'opacity-0 translate-y-4'}`}
              style={{ animationDelay: storySeen ? '240ms' : undefined, animationFillMode: 'forwards' }}
            >
              <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 text-2xl transition hover:scale-105">✨</div>
              <h3 className="mt-5 text-lg font-semibold text-slate-900">The solution</h3>
              <p className="mt-2 text-sm leading-relaxed text-slate-600">
                A <strong>proactive tap on the shoulder</strong>—not just festivals. End-of-day: &quot;Aaj ka sale, mahine ka profit.&quot; Location-based: &quot;Aapke area mein shaadi season, demand 40% up.&quot; Life-driven alerts, not reactive chatbots.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* —— WHY THIS TOPIC —— */}
      <section ref={whyRef} className="border-t border-slate-200/80 bg-gradient-to-b from-white to-amber-50/30 py-16 md:py-24">
        <div className={`mx-auto max-w-5xl px-4 transition-all duration-700 ${whySeen ? 'animate-fade-in-up opacity-100' : 'opacity-0 translate-y-6'}`}>
          <p className="text-center text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">Why this matters</p>
          <h2 className="mt-2 text-center text-3xl font-bold text-slate-900 md:text-4xl">Why This Topic</h2>
          <p className="mx-auto mt-4 max-w-2xl text-center text-slate-600">
            India&apos;s kiranas are the backbone of retail—but they&apos;re under pressure and left out of AI.
          </p>
          <div className="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div className="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <p className="text-2xl font-bold text-sahayak-amber md:text-3xl">12–15M</p>
              <p className="mt-1 text-sm font-medium text-slate-700">Kirana outlets</p>
            </div>
            <div className="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <p className="text-2xl font-bold text-sahayak-green md:text-3xl">~11%</p>
              <p className="mt-1 text-sm font-medium text-slate-700">Of India&apos;s GDP</p>
            </div>
            <div className="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <p className="text-2xl font-bold text-slate-800 md:text-3xl">~40M</p>
              <p className="mt-1 text-sm font-medium text-slate-700">Jobs dependent</p>
            </div>
            <div className="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <p className="text-2xl font-bold text-rose-600 md:text-3xl">~2L</p>
              <p className="mt-1 text-sm font-medium text-slate-700">Closures in 2024</p>
            </div>
          </div>
          <p className="mx-auto mt-8 max-w-xl text-center text-sm text-slate-500">
            $800B+ flows through kiranas. Inventory chaos alone burns $120–180B yearly. We chose this because <strong className="text-slate-700">impact here is massive</strong>.
          </p>
        </div>
      </section>

      {/* —— WHY WE CHOSE IT (REACTIVE VS LIFE-DRIVEN) —— */}
      <section ref={choseRef} className="border-t border-slate-200/80 bg-slate-900 py-16 md:py-24">
        <div className={`mx-auto max-w-5xl px-4 transition-all duration-700 ${choseSeen ? 'animate-fade-in-up opacity-100' : 'opacity-0 translate-y-6'}`}>
          <p className="text-center text-xs font-semibold uppercase tracking-[0.25em] text-emerald-400">Our differentiator</p>
          <h2 className="mt-2 text-center text-3xl font-bold text-white md:text-4xl">Why We Chose It: Life-Driven, Not Reactive</h2>
          <div className="mt-12 grid gap-8 md:grid-cols-2">
            <div className="rounded-2xl border border-slate-600 bg-slate-800/50 p-6">
              <p className="text-sm font-semibold uppercase tracking-wide text-rose-400">Most systems</p>
              <p className="mt-2 text-lg font-semibold text-slate-200">Reactive</p>
              <p className="mt-1 text-sm text-slate-400">React to past sales. By the time you see the spike, shelves are already empty.</p>
            </div>
            <div className="rounded-2xl border border-emerald-500/50 bg-emerald-950/30 p-6 animate-glow-pulse">
              <p className="text-sm font-semibold uppercase tracking-wide text-emerald-400">AI Sahayak</p>
              <p className="mt-2 text-lg font-semibold text-white">Life-driven</p>
              <p className="mt-1 text-sm text-slate-300">EventBridge + location &amp; calendar. We tap Raju with daily sales/profit and <em>before</em> local events (festivals, shaadi, sports day)—with a Confidence Score, not a guess.</p>
            </div>
          </div>
        </div>
      </section>

      {/* —— THE IMPACT —— */}
      <section ref={impactRef} className="border-t border-slate-200/80 bg-gradient-to-b from-white to-emerald-50/20 py-16 md:py-24">
        <div className={`mx-auto max-w-5xl px-4 transition-all duration-700 ${impactSeen ? 'animate-fade-in-up opacity-100' : 'opacity-0 translate-y-6'}`}>
          <p className="text-center text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">What changes</p>
          <h2 className="mt-2 text-center text-3xl font-bold text-slate-900 md:text-4xl">The Impact</h2>
          <ul className="mx-auto mt-10 max-w-2xl space-y-4 text-slate-700">
            <li className="flex gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <span className="text-xl">📢</span>
              <span><strong className="text-slate-900">Proactive alerts</strong> — End-of-day: today&apos;s sales, monthly profit/loss. Location-based: &quot;Nearby shaadi season, demand +40%&quot; with a real ML Confidence Score (SageMaker Canvas).</span>
            </li>
            <li className="flex gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <span className="text-xl">📍</span>
              <span><strong className="text-slate-900">Location-based</strong> — Store pincode taps nearby events: shaadi, functions, sports day, festivals. Demand alerts when it matters.</span>
            </li>
            <li className="flex gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <span className="text-xl">💬</span>
              <span><strong className="text-slate-900">Bhashini-style voice</strong> — Ask in Hindi, Hinglish. &quot;Aaj kitna sale hua?&quot; or &quot;Pichle saal kitna tel bika?&quot; Bedrock + S3/DynamoDB answer in seconds.</span>
            </li>
            <li className="flex gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <span className="text-xl">📊</span>
              <span><strong className="text-slate-900">Explainable what-if</strong> — Slide a discount, see profit impact. A &quot;Why?&quot; button explains in Hinglish (Bedrock).</span>
            </li>
          </ul>
        </div>
      </section>

      {/* —— CTA —— */}
      <section ref={ctaRef} className="border-t border-slate-200/80 bg-gradient-to-b from-white via-white to-emerald-50/90 py-20 md:py-28">
        <div className={`mx-auto max-w-3xl px-4 text-center transition-all duration-700 ${ctaSeen ? 'animate-scale-in opacity-100' : 'opacity-0 scale-95'}`}>
          <h2 className="text-2xl font-bold text-slate-900 md:text-3xl">Experience Raju Bhai&apos;s journey</h2>
          <p className="mt-4 text-slate-600">
            Home → <strong>Onboarding</strong> → <strong>Dashboard</strong> → <strong>Raju&apos;s day</strong> (alerts &amp; talks).
          </p>
          <div className="mt-8 flex flex-wrap items-center justify-center gap-2">
            <span className="rounded-full bg-slate-100 px-3 py-1 text-[0.7rem] font-medium text-slate-600">EventBridge</span>
            <span className="rounded-full bg-slate-100 px-3 py-1 text-[0.7rem] font-medium text-slate-600">SageMaker Canvas</span>
            <span className="rounded-full bg-slate-100 px-3 py-1 text-[0.7rem] font-medium text-slate-600">Bedrock</span>
            <span className="rounded-full bg-slate-100 px-3 py-1 text-[0.7rem] font-medium text-slate-600">DynamoDB</span>
            <span className="rounded-full bg-slate-100 px-3 py-1 text-[0.7rem] font-medium text-slate-600">S3</span>
          </div>
          <div className="mt-10 flex flex-wrap items-center justify-center gap-3">
            <button
              type="button"
              onClick={onStart}
              className="inline-flex items-center gap-2 rounded-full bg-sahayak-green px-8 py-4 text-base font-semibold text-slate-950 shadow-xl shadow-emerald-500/40 transition hover:scale-[1.02] hover:bg-emerald-400 hover:shadow-emerald-500/50"
            >
              Start the journey →
            </button>
            <button
              type="button"
              onClick={onSkipToDashboard}
              className="rounded-full border-2 border-slate-200 bg-white px-6 py-3 text-sm font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50"
            >
              Dashboard
            </button>
            <button
              type="button"
              onClick={onSkipToDay}
              className="rounded-full border-2 border-slate-200 bg-white px-6 py-3 text-sm font-medium text-slate-700 hover:border-slate-300 hover:bg-slate-50"
            >
              Raju&apos;s day
            </button>
          </div>
          <div className="mt-12 rounded-2xl border border-amber-200/80 bg-amber-50/60 px-4 py-3 text-left">
            <p className="text-[0.7rem] font-semibold uppercase tracking-wide text-amber-800">For judges</p>
            <p className="mt-1 text-sm text-slate-700">See the full flow: start with <strong>Onboarding</strong> (Step 2), then <strong>Dashboard</strong>, then <strong>Raju&apos;s day</strong>. ~2 min end-to-end.</p>
          </div>
        </div>
      </section>

      {/* —— FOOTER —— */}
      <footer className="border-t border-slate-200/80 bg-slate-900 py-8 text-center text-slate-400">
        <p className="text-sm font-medium text-slate-300">GenGurus</p>
        <p className="mt-1 text-[0.75rem]">AWS AI for Bharat Hackathon · Professional Track · Retail &amp; Market Intelligence</p>
      </footer>
    </main>
  )
}

/** Optional: pass this to wire your real bot. Called when user sends a message; return the bot reply to show in the phone. */
export type OnboardingBotReply = (userMessage: string) => Promise<string>
/** Optional: called when user uploads a photo (camera/gallery). Return the bot reply. */
export type OnboardingImageUpload = (base64: string, mimeType: string) => Promise<string>
/** Optional: Bhashini voice – send audio, get back reply + transcribed text. */
export type OnboardingVoiceMessage = (audioBase64: string, mimeType: string) => Promise<{ reply: string; transcribed_text?: string }>

type ChatOnboardingProps = {
  onContinue: () => void
  /** Wire your bot here. When user sends a message in the phone, this is called with the text; return the bot's reply to show it in the chat. */
  onBotReply?: OnboardingBotReply
  /** When user picks a photo (camera button), this is called with base64 + mime type; return the bot's reply. */
  onImageUpload?: OnboardingImageUpload
  /** When user sends a voice message, this is called with base64 audio; returns { reply, transcribed_text } (Bhashini ASR). */
  onVoiceMessage?: OnboardingVoiceMessage
}

// No pre-fed chat: all messages come from the user and your friend's backend (LangGraph bot).
const onboardingScript: { from: 'user' | 'bot'; text: string }[] = []

function ChatOnboarding({ onContinue, onBotReply, onImageUpload, onVoiceMessage }: ChatOnboardingProps) {
  const [step, setStep] = useState(1)
  const [liveMessages, setLiveMessages] = useState<{ from: 'user' | 'bot'; text: string }[]>([])
  const [inputValue, setInputValue] = useState('')
  const [sending, setSending] = useState(false)
  const [recording, setRecording] = useState(false)
  const chatEndRef = useRef<HTMLDivElement>(null)
  const cameraInputRef = useRef<HTMLInputElement>(null)
  const docInputRef = useRef<HTMLInputElement>(null)
  const mediaRecorderRef = useRef<MediaRecorder | null>(null)
  const audioChunksRef = useRef<Blob[]>([])
  const [playingTtsIdx, setPlayingTtsIdx] = useState<number | null>(null)
  const ttsAudioRef = useRef<HTMLAudioElement | null>(null)
  const agentApiBase = (import.meta as any).env?.VITE_AGENT_API_BASE || 'http://localhost:8000'

  const scriptMessages = onboardingScript.slice(0, step)
  const visibleMessages = [...scriptMessages, ...liveMessages]
  const atEnd = step >= onboardingScript.length

  const scrollToBottom = () => chatEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  useEffect(() => { scrollToBottom() }, [visibleMessages.length])

  useEffect(() => {
    if (atEnd) return
    const timer = setTimeout(
      () => setStep((s) => Math.min(s + 1, onboardingScript.length)),
      1400
    )
    return () => clearTimeout(timer)
  }, [atEnd])

  async function handleSend() {
    const text = inputValue.trim()
    if (!text || sending) return
    setInputValue('')
    setLiveMessages((prev) => [...prev, { from: 'user', text }])
    setSending(true)
    try {
      if (onBotReply) {
        const reply = await onBotReply(text)
        if (reply) setLiveMessages((prev) => [...prev, { from: 'bot', text: reply }])
      } else {
        setLiveMessages((prev) => [
          ...prev,
          { from: 'bot', text: 'Demo mode: connect your bot by passing onBotReply to ChatOnboarding.' },
        ])
      }
    } catch {
      setLiveMessages((prev) => [
        ...prev,
        { from: 'bot', text: 'Something went wrong. Please try again.' },
      ])
    } finally {
      setSending(false)
    }
  }

  function readFileAsBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader()
      reader.onload = () => {
        const dataUrl = reader.result as string
        const base64 = dataUrl.split(',')[1] ?? ''
        resolve(base64)
      }
      reader.onerror = reject
      reader.readAsDataURL(file)
    })
  }

  async function handleCameraFile(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0]
    e.target.value = ''
    if (!file || !file.type.startsWith('image/')) return
    setLiveMessages((prev) => [...prev, { from: 'user', text: '📷 Photo attached' }])
    setSending(true)
    try {
      const base64 = await readFileAsBase64(file)
      const mimeType = file.type || 'image/jpeg'
      if (onImageUpload) {
        const reply = await onImageUpload(base64, mimeType)
        if (reply) setLiveMessages((prev) => [...prev, { from: 'bot', text: reply }])
      } else {
        setLiveMessages((prev) => [...prev, { from: 'bot', text: 'Photo received. You can send more or type a message.' }])
      }
    } catch {
      setLiveMessages((prev) => [...prev, { from: 'bot', text: 'Could not upload photo. Please try again.' }])
    } finally {
      setSending(false)
    }
  }

  function handleDocFile(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0]
    e.target.value = ''
    if (!file) return
    const name = file.name
    setLiveMessages((prev) => [...prev, { from: 'user', text: `📄 Document attached: ${name}` }])
    setLiveMessages((prev) => [...prev, { from: 'bot', text: "Thanks for uploading. We'll use this for verification." }])
  }

  async function startVoiceRecording() {
    if (!onVoiceMessage || sending || recording) return
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true })
      audioChunksRef.current = []
      const mime = MediaRecorder.isTypeSupported('audio/webm;codecs=opus') ? 'audio/webm;codecs=opus' : 'audio/webm'
      const recorder = new MediaRecorder(stream)
      recorder.ondataavailable = (e) => { if (e.data.size) audioChunksRef.current.push(e.data) }
      recorder.onstop = async () => {
        stream.getTracks().forEach((t) => t.stop())
        const blob = new Blob(audioChunksRef.current, { type: mime })
        const reader = new FileReader()
        reader.onloadend = async () => {
          const base64 = (reader.result as string)?.split(',')[1] ?? ''
          if (!base64) return
          setSending(true)
          setLiveMessages((prev) => [...prev, { from: 'user', text: '🎤 …' }])
          try {
            const result = await onVoiceMessage(base64, mime)
            setLiveMessages((prev) => {
              const withoutPlaceholder = prev.slice(0, -1)
              const userText = result.transcribed_text || '🎤 Voice message'
              return [...withoutPlaceholder, { from: 'user', text: userText }, { from: 'bot', text: result.reply }]
            })
          } catch {
            setLiveMessages((prev) => {
              const withoutPlaceholder = prev.slice(0, -1)
              return [...withoutPlaceholder, { from: 'user', text: '🎤 Voice message' }, { from: 'bot', text: 'Voice not available. Please type your message.' }]
            })
          } finally {
            setSending(false)
          }
        }
        reader.readAsDataURL(blob)
      }
      mediaRecorderRef.current = recorder
      recorder.start(200)
      setRecording(true)
    } catch (err) {
      console.error('Microphone access error', err)
    }
  }

  function stopVoiceRecording() {
    if (!recording || !mediaRecorderRef.current) return
    mediaRecorderRef.current.stop()
    mediaRecorderRef.current = null
    setRecording(false)
  }

  function toggleVoiceRecording() {
    if (recording) stopVoiceRecording()
    else startVoiceRecording()
  }

  async function playTts(text: string, msgIdx: number) {
    if (!text.trim() || playingTtsIdx !== null) return
    setPlayingTtsIdx(msgIdx)
    try {
      const res = await fetch(`${agentApiBase}/v1/tts`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text.trim(), language_code: 'hi-IN' }),
      })
      if (!res.ok) throw new Error('TTS failed')
      const data = await res.json()
      const binary = atob(data.audio_base64)
      const bytes = new Uint8Array(binary.length)
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i)
      const blob = new Blob([bytes], { type: 'audio/mpeg' })
      const url = URL.createObjectURL(blob)
      const audio = new Audio(url)
      ttsAudioRef.current = audio
      audio.onended = () => { URL.revokeObjectURL(url); setPlayingTtsIdx(null) }
      audio.onerror = () => { URL.revokeObjectURL(url); setPlayingTtsIdx(null) }
      await audio.play()
    } catch {
      setPlayingTtsIdx(null)
    }
  }

  function stopTts() {
    if (ttsAudioRef.current) {
      ttsAudioRef.current.pause()
      ttsAudioRef.current = null
    }
    setPlayingTtsIdx(null)
  }

  return (
    <main className="flex flex-1 flex-col gap-6 md:flex-row md:items-stretch">
      <section className="flex flex-1 flex-col justify-center gap-4">
        <h2 className="text-2xl font-semibold tracking-tight text-slate-900 md:text-3xl">
          WhatsApp-first, zero-touch onboarding
        </h2>
        <p className="max-w-xl text-base text-slate-700 md:text-lg">
          This screen simulates the exact WhatsApp flow Raju Bhai will see when he scans a QR code from a
          newspaper or distributor poster. In production we plug this into WhatsApp Business API – for the
          hackathon, we keep it inside the browser for reliability. On this step Raju only chats and verifies
          his basic details; heavy data upload happens later in the dashboard.
        </p>
        <ul className="space-y-2 text-sm text-slate-700">
          <li className="flex gap-2">
            <span className="mt-1 h-1.5 w-1.5 rounded-full bg-emerald-600" />
            <span>
              <span className="font-semibold text-slate-900">No forms, only chat:</span> shop name, category,
              pincode captured as friendly Hinglish messages.
            </span>
          </li>
          <li className="flex gap-2">
            <span className="mt-1 h-1.5 w-1.5 rounded-full bg-emerald-600" />
            <span>
              <span className="font-semibold text-slate-900">Lightweight identity only:</span> Raju just chats
              to share shop details and basic verification. Bills, stock lists and photos are collected later
              from the web dashboard.
            </span>
          </li>
          <li className="flex gap-2">
            <span className="mt-1 h-1.5 w-1.5 rounded-full bg-emerald-600" />
            <span>
              <span className="font-semibold text-slate-900">Auto-activation:</span> as soon as Holi forecast is
              ready, Raju jumps into the Command Center with one tap.
            </span>
          </li>
          <li className="flex gap-2">
            <span className="mt-1 h-1.5 w-1.5 rounded-full bg-emerald-600" />
            <span>
              <span className="font-semibold text-slate-900">Feels like real WhatsApp:</span> plus, mic, ₹, camera and gallery icons mirror Raju&apos;s normal chat—under the hood you can still wire a real bot via the <code className="rounded bg-slate-200 px-1 text-xs">onBotReply</code> prop.
            </span>
          </li>
          <li className="flex gap-2">
            <span className="mt-1 h-1.5 w-1.5 rounded-full bg-emerald-600" />
            <span>
              <span className="font-semibold text-slate-900">Always-on WhatsApp alerts:</span> once onboarded,
              Raju keeps getting proactive alerts here, while uploads and deeper analysis live in his dashboard.
            </span>
          </li>
        </ul>

        <div className="mt-2 flex flex-wrap gap-3">
          {atEnd && (
            <button
              type="button"
              onClick={onContinue}
              className="rounded-full bg-slate-900 px-5 py-2 text-sm font-semibold text-slate-50 hover:bg-slate-800"
            >
              Open Growth Command Center
            </button>
          )}
        </div>
      </section>

      <section className="flex flex-1 items-center justify-center p-4 min-h-0 max-h-[calc(100vh-9rem)]">
        {/* Realistic phone: fits in viewport (no scroll), slim + tall 9:19.5 aspect */}
        <div className="flex items-center justify-center h-[min(520px,calc(100vh-9rem))] w-full max-h-full">
          <div className="relative h-[min(500px,calc(100vh-9rem))] w-auto aspect-[9/20] flex items-center justify-center shrink-0 max-h-full">
            {/* Left side button (mute/volume) - aligned to phone edge */}
            <div className="absolute -left-1 top-[18%] h-14 w-1 rounded-l bg-slate-700 shadow-inner" />
            <div className="absolute -left-1 top-[24%] h-10 w-1 rounded-l bg-slate-700 shadow-inner" />
            <div className="absolute -left-1 top-[30%] h-10 w-1 rounded-l bg-slate-700 shadow-inner" />
            {/* Right side button (power) */}
            <div className="absolute -right-1 top-[22%] h-20 w-1 rounded-r bg-slate-700 shadow-inner" />

            <div className="relative h-full w-full flex flex-col rounded-[2.75rem] border-[12px] border-slate-900 bg-slate-900 shadow-[0_0_0_2px_rgba(0,0,0,0.25),0_25px_50px_-12px_rgba(0,0,0,0.45),0_0_60px_-20px_rgba(0,0,0,0.35),inset_0_1px_0_rgba(255,255,255,0.06)]">
            {/* Notch with camera and speaker */}
            <div className="absolute left-1/2 top-0 z-10 flex h-6 w-24 -translate-x-1/2 items-center justify-center rounded-b-xl bg-slate-900">
              <div className="h-1.5 w-8 rounded-full bg-slate-950" />
              <div className="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-slate-800 ring-2 ring-slate-950" />
            </div>
            {/* Screen */}
            <div className="overflow-hidden rounded-[2.25rem] bg-[#0b141a] flex-1 min-h-0 flex flex-col">
              <div className="flex flex-1 min-h-0 flex-col bg-[#0b141a]">
                {/* Status bar (phone notch area) */}
                <div className="flex h-8 shrink-0 items-center justify-between bg-[#0b141a] px-6 pt-1 text-[0.65rem] text-[#8696a0]">
                  <span>9:41</span>
                  <span className="flex items-center gap-0.5">
                    <span className="inline-block h-2 w-4 rounded-sm border border-slate-500">
                      <span className="ml-0.5 mt-0.5 block h-1 w-2 rounded-[1px] bg-slate-400" />
                    </span>
                  </span>
                </div>
                {/* WhatsApp-style chat header with logo */}
                <div className="flex shrink-0 items-center gap-3 border-b border-[#2a3942] bg-[#202c33] px-2 py-2">
                  <button type="button" className="flex shrink-0 text-slate-300" aria-label="Back">
                    <svg className="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" /></svg>
                  </button>
                  <div className="relative h-9 w-9 shrink-0 overflow-hidden rounded-full border border-[#2a3942] bg-[#0b141a]">
                    <img src="/Generated_image.png" alt="" className="h-full w-full object-cover" />
                  </div>
                  <div className="min-w-0 flex-1">
                    <p className="truncate text-[0.95rem] font-medium text-white">AI Sahayak</p>
                    <p className="text-[0.7rem] text-[#8696a0]">online</p>
                  </div>
                  <div className="flex shrink-0 items-center gap-1 text-[#aebac1]">
                    <button type="button" className="rounded-full p-2 hover:bg-white/10" aria-label="Voice call">
                      <svg className="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    </button>
                    <button type="button" className="rounded-full p-2 hover:bg-white/10" aria-label="Video call">
                      <svg className="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z" /></svg>
                    </button>
                    <button type="button" className="rounded-full p-2 hover:bg-white/10" aria-label="Menu">
                      <svg className="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" /></svg>
                    </button>
                  </div>
                </div>
                {/* WhatsApp-style chat area (pattern-like bg) */}
                <div className="flex flex-1 flex-col overflow-y-auto bg-[#0b141a] p-2" style={{ backgroundImage: 'radial-gradient(circle at 50% 50%, #1f2c33 1px, transparent 1px)', backgroundSize: '20px 20px' }}>
                  <div className="flex flex-col gap-1 text-[0.8rem]">
                    {visibleMessages.map((msg, idx) => (
                      <div
                        key={`${msg.from}-${idx}`}
                        className={`flex ${msg.from === 'user' ? 'justify-end' : 'justify-start'}`}
                      >
                        <div
                          className={`flex max-w-[85%] items-center gap-1.5 rounded-lg px-3 py-1.5 shadow-sm ${
                            msg.from === 'user'
                              ? 'rounded-br-md bg-[#005c4b] text-[#e9edef]'
                              : 'rounded-bl-md bg-[#202c33] text-[#e9edef]'
                          }`}
                        >
                          <span className="min-w-0 flex-1">{msg.text}</span>
                          {msg.from === 'bot' && msg.text && (
                            <button
                              type="button"
                              onClick={() => playingTtsIdx === idx ? stopTts() : playTts(msg.text, idx)}
                              className="shrink-0 rounded-full p-1 text-[#8696a0] hover:bg-white/10 hover:text-white"
                              aria-label={playingTtsIdx === idx ? 'Stop playback' : 'Listen (TTS)'}
                              title="AI speaks (Hindi)"
                            >
                              {playingTtsIdx === idx ? (
                                <svg className="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h12v12H6z" /></svg>
                              ) : (
                                <svg className="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" /></svg>
                              )}
                            </button>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                  <div ref={chatEndRef} />
                </div>
                {/* Hidden file inputs for camera and docs */}
                <input
                  ref={cameraInputRef}
                  type="file"
                  accept="image/*"
                  capture="environment"
                  className="hidden"
                  aria-hidden
                  onChange={handleCameraFile}
                />
                <input
                  ref={docInputRef}
                  type="file"
                  accept=".pdf,image/*,.doc,.docx"
                  className="hidden"
                  aria-hidden
                  onChange={handleDocFile}
                />
                {/* WhatsApp-style input bar */}
                <div className="shrink-0 border-t border-[#2a3942] bg-[#202c33] p-2">
                  <div className="flex items-center gap-2">
                    {/* Plus = attach docs (ID proof, etc.) */}
                    <button
                      type="button"
                      onClick={() => docInputRef.current?.click()}
                      className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#202c33] text-[#8696a0] hover:bg-white/10"
                      aria-label="Attach document (ID proof, etc.)"
                    >
                      <svg className="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeWidth={2} strokeLinecap="round" strokeLinejoin="round" d="M12 5v14M5 12h14" />
                      </svg>
                    </button>
                    {/* Input pill with mic inside */}
                    <div className="flex min-w-0 flex-1 items-center rounded-full bg-[#111b21] px-3 py-1.5">
                      <input
                        type="text"
                        value={inputValue}
                        onChange={(e) => setInputValue(e.target.value)}
                        onKeyDown={(e) => e.key === 'Enter' && !e.shiftKey && handleSend()}
                        placeholder="Message"
                        className="min-w-0 flex-1 bg-transparent pr-2 text-[0.9rem] text-[#e9edef] placeholder:text-[#8696a0] focus:outline-none"
                        disabled={sending}
                      />
                      <button
                        type="button"
                        onClick={toggleVoiceRecording}
                        disabled={sending || !onVoiceMessage}
                        className={`shrink-0 rounded-full p-1 ${recording ? 'bg-red-500/20 text-red-400' : 'text-[#8696a0] hover:bg-white/5'}`}
                        aria-label={recording ? 'Stop recording' : 'Voice message (Bhashini)'}
                        title={onVoiceMessage ? (recording ? 'Tap to stop' : 'Hold to speak in Hindi/Hinglish') : 'Voice not configured'}
                      >
                        <svg className="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 14a3 3 0 0 0 3-3V7a3 3 0 0 0-6 0v4a3 3 0 0 0 3 3z" />
                          <path d="M19 11a1 1 0 0 0-2 0 5 5 0 0 1-10 0 1 1 0 0 0-2 0 7 7 0 0 0 6 6.92V21a1 1 0 0 0 2 0v-3.08A7 7 0 0 0 19 11z" />
                        </svg>
                      </button>
                    </div>
                    {/* Right-side icons: payments, camera, gallery */}
                    <button
                      type="button"
                      className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[#8696a0] hover:bg-white/10"
                      aria-label="Payments"
                    >
                      <span className="text-sm font-semibold">₹</span>
                    </button>
                    <button
                      type="button"
                      onClick={() => cameraInputRef.current?.click()}
                      className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[#8696a0] hover:bg-white/10"
                      aria-label="Camera or choose photo"
                    >
                      <svg className="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M9 3 7.17 5H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-3.17L15 3H9z" />
                        <path d="M12 9a4 4 0 1 0 0 8 4 4 0 0 0 0-8z" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      onClick={() => cameraInputRef.current?.click()}
                      className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[#8696a0] hover:bg-white/10"
                      aria-label="Gallery or choose photo"
                    >
                      <svg className="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M5 4a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H5zm0 2h14a1 1 0 0 1 1 1v6.59l-3.3-3.3a1 1 0 0 0-1.4 0L12 17l-2.3-2.3a1 1 0 0 0-1.4 0L4 19V7a1 1 0 0 1 1-1z" />
                        <circle cx="8" cy="9" r="1.25" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
            {/* Home indicator */}
            <div className="absolute bottom-1.5 left-1/2 h-1 w-20 -translate-x-1/2 rounded-full bg-slate-600" />
            </div>
          </div>
        </div>
      </section>
    </main>
  )
}

type RajuDayProps = {
  welcomeName?: string | null
  onBackToDashboard: () => void
}

type DayMessage = {
  from: 'user' | 'bot' | 'alert'
  text: string
  time?: string
}

/**
 * Build today's alerts from FESTIVAL_CALENDAR.
 * Same logic the Lambda uses - shows any festival within FESTIVAL_ALERT_DAYS days.
 * If none are upcoming, falls back to static demo alerts for the UI.
 */
function buildTodayAlerts(): DayMessage[] {
  const today = new Date()
  const upcoming: DayMessage[] = []
  for (const fest of FESTIVAL_CALENDAR) {
    const festDate = new Date(fest.date)
    const diffDays = Math.ceil((festDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24))
    if (diffDays > 0 && diffDays <= FESTIVAL_ALERT_DAYS) {
      const prefix = diffDays === 1 ? 'Kal hai!' : diffDays <= 3 ? `Sirf ${diffDays} din bache hain!` : `${diffDays} din baad!`
      upcoming.push({ from: 'alert', text: `${prefix} ${fest.hinglishAlert}`, time: '9:00 AM' })
    }
  }
  if (upcoming.length > 0) return upcoming
  // Demo alerts shown when no festival is within 5 days
  return [
    { from: 'alert', text: '🎉 Holi in 4 din! Gulal, Ghee aur Shakkar ka stock check kar lo!', time: '9:00 AM' },
    { from: 'alert', text: '📊 Aaj ki sales: Rs 15,200 (kal se 12% zyada!) Badiya chal raha hai!', time: '9:30 AM' },
    { from: 'alert', text: '💒 Indore mein wedding season - Dry fruits, Mithai aur gifting items ka stock ready karo!', time: '11:00 AM' },
  ]
}

const INITIAL_ALERTS: DayMessage[] = buildTodayAlerts()

function RajuDay({ welcomeName, onBackToDashboard }: RajuDayProps) {
  const displayName = formatWelcomeName(welcomeName)
  const [welcome, setWelcome] = useState<{ main: string; sub: string } | null>(() =>
    displayName ? getWelcomeMessage(displayName, false) : null
  )
  useEffect(() => {
    if (displayName && !welcome) setWelcome(getWelcomeMessage(displayName, false))
  }, [displayName, welcome])

  const agentApiBase = (import.meta as any).env?.VITE_AGENT_API_BASE || 'http://localhost:8000'
  const [messages, setMessages] = useState(INITIAL_ALERTS)
  const [input, setInput] = useState('')
  const [sending, setSending] = useState(false)
  const messagesEndRef = useRef<HTMLDivElement>(null)

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  }, [messages])

  async function sendMessage() {
    const text = input.trim()
    if (!text || sending) return
    setInput('')
    setMessages((prev) => [...prev, { from: 'user', text }])
    setSending(true)
    try {
      const response = await fetch(`${agentApiBase}/v1/webhook/incoming`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_id: displayName || 'raju-day-user',
          text,
          platform: 'web',
          session_id: 'raju-day-session',
        }),
      })
      if (!response.ok) throw new Error('Bot unavailable')
      const data = await response.json()
      const reply = data.reply || data.message || 'No reply from bot.'
      setMessages((prev) => [...prev, { from: 'bot', text: reply }])
    } catch {
      setMessages((prev) => [...prev, { from: 'bot', text: 'Bot is unavailable right now. Please try again.' }])
    } finally {
      setSending(false)
    }
  }

  return (
    <main className="flex flex-1 flex-col gap-6 md:flex-row md:items-stretch">
      <section className="flex flex-1 flex-col justify-center gap-4">
        {welcome && (
          <div className="rounded-xl border border-emerald-200 bg-emerald-50/90 px-4 py-3 shadow-sm">
            <p className="text-lg font-semibold text-emerald-900">{welcome.main}</p>
            <p className="mt-0.5 text-sm text-emerald-800">{welcome.sub}</p>
          </div>
        )}
        <p className="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-600">Step 4</p>
        <h2 className="text-2xl font-semibold tracking-tight text-slate-900 md:text-3xl">
          Raju&apos;s day — Alerts &amp; talks
        </h2>
        <p className="max-w-xl text-base text-slate-700 md:text-lg">
          This is where Raju Bhai lives day to day: <strong>daily alerts</strong> (sales, profit/loss), <strong>location-based nudges</strong> (festivals, events), and <strong>normal conversation</strong> with the AI. Alerts come from EventBridge + Calendar; chat goes to the same bot as onboarding.
        </p>
        <ul className="space-y-2 text-sm text-slate-700">
          <li className="flex gap-2">
            <span className="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" />
            <span><strong>Proactive alerts:</strong> System sends Holi reminders, daily sales, event nudges</span>
          </li>
          <li className="flex gap-2">
            <span className="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" />
            <span><strong>Chat anytime:</strong> Ask "Next month profit?", "Order 20kg gulal", etc.</span>
          </li>
          <li className="flex gap-2">
            <span className="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" />
            <span><strong>WhatsApp-style:</strong> Same UI as onboarding, but with alerts mixed in</span>
          </li>
        </ul>
        <button
          type="button"
          onClick={onBackToDashboard}
          className="mt-4 w-fit rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
          ← Back to Dashboard
        </button>
      </section>
      <section className="flex flex-1 items-center justify-center">
        <div className="flex w-full max-w-sm flex-col rounded-[2rem] border-2 border-slate-300 bg-slate-900/90 p-3 shadow-2xl shadow-slate-400/20">
          <div className="mb-3 flex items-center justify-between px-1">
            <div className="flex items-center gap-2">
              <div className="h-7 w-7 rounded-full bg-emerald-500/40" />
              <div>
                <p className="text-xs font-semibold text-slate-100">AI Sahayak</p>
                <p className="text-[0.65rem] text-emerald-400">Raju&apos;s day · Alerts &amp; chat</p>
              </div>
            </div>
          </div>
          <div className="flex flex-1 flex-col gap-2 overflow-y-auto rounded-2xl bg-slate-800/60 p-3" style={{ maxHeight: '400px' }}>
            {messages.map((msg, i) => (
              <div key={i} className={`flex ${msg.from === 'user' ? 'justify-end' : 'justify-start'}`}>
                <div
                  className={`max-w-[80%] rounded-xl px-3 py-2 text-sm ${
                    msg.from === 'alert'
                      ? 'bg-amber-500/20 text-amber-100 border border-amber-400/30'
                      : msg.from === 'user'
                        ? 'bg-emerald-600 text-white'
                        : 'bg-slate-700 text-slate-100'
                  }`}
                >
                  {msg.time && <p className="mb-1 text-[0.65rem] opacity-70">{msg.time}</p>}
                  <p className="whitespace-pre-wrap break-words">{msg.text}</p>
                </div>
              </div>
            ))}
            <div ref={messagesEndRef} />
          </div>
          <div className="mt-3 flex items-center gap-2 rounded-xl bg-slate-700/60 px-3 py-2">
            <input
              type="text"
              placeholder="Type a message…"
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyDown={(e) => e.key === 'Enter' && sendMessage()}
              disabled={sending}
              className="flex-1 bg-transparent text-sm text-slate-100 placeholder:text-slate-400 focus:outline-none"
            />
            <button
              type="button"
              onClick={sendMessage}
              disabled={sending || !input.trim()}
              className="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-500 disabled:opacity-50"
            >
              {sending ? '…' : 'Send'}
            </button>
          </div>
        </div>
      </section>
    </main>
  )
}

function formatWelcomeName(username: string | null | undefined): string {
  if (!username) return ''
  return username
    .split(/[\s_-]+/)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())
    .join(' ')
}

// Welcome phrases in English, Hindi, Hinglish (pick one for variety)
const WELCOME_PHRASES = [
  { en: 'Welcome to your dashboard.', hi: 'Aapke dashboard par aapka swagat hai.', hinglish: 'Apna dashboard dekho – welcome!' },
  { en: 'Great to see you here.', hi: 'Aapko yahan dekh kar khushi hui.', hinglish: 'Achha laga aapko yahan dekh ke!' },
  { en: 'Your command center is ready.', hi: 'Aapka command center taiyar hai.', hinglish: 'Tumhara dashboard ready hai!' },
]

function getWelcomeMessage(displayName: string, isDashboard: boolean): { main: string; sub: string } {
  const place = isDashboard ? 'dashboard' : "Raju's day"
  const phrases = WELCOME_PHRASES[Math.floor(Math.random() * WELCOME_PHRASES.length)]
  const lang = ['en', 'hi', 'hinglish'][Math.floor(Math.random() * 3)] as 'en' | 'hi' | 'hinglish'
  const sub = lang === 'en' ? phrases.en : lang === 'hi' ? phrases.hi : phrases.hinglish
  return {
    main: `Namaste, ${displayName}!`,
    sub: `${sub}`,
  }
}

type DashboardProps = {
  welcomeName?: string | null
  onBackToChat: () => void
  onToRajuDay: () => void
}

function WelcomeCard({
  main,
  sub,
  onContinue,
}: {
  main: string
  sub: string
  onContinue: () => void
}) {
  return (
    <div className="flex flex-1 items-center justify-center">
      <div className="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <p className="text-center text-lg font-semibold text-slate-900">{main}</p>
        <p className="mt-2 text-center text-sm text-slate-600">{sub}</p>
        <button
          type="button"
          onClick={onContinue}
          className="mt-5 w-full rounded-full bg-slate-900 px-4 py-2.5 text-sm font-semibold text-slate-50 shadow-sm hover:bg-slate-800"
        >
          Continue to dashboard
        </button>
      </div>
    </div>
  )
}

function Dashboard({ welcomeName, onBackToChat, onToRajuDay }: DashboardProps) {
  const [discount, setDiscount] = useState(10)
  const [welcomeCardDismissed, setWelcomeCardDismissed] = useState(false)
  const displayName = formatWelcomeName(welcomeName)
  const [welcome, setWelcome] = useState<{ main: string; sub: string } | null>(() =>
    displayName ? getWelcomeMessage(displayName, true) : null
  )
  useEffect(() => {
    if (displayName && !welcome) setWelcome(getWelcomeMessage(displayName, true))
  }, [displayName, welcome])

  const baseProfit = 15000
  const holiBoost = 0.4
  const discountBoost = discount / 100

  const projectedProfit = Math.round(baseProfit * (1 + holiBoost + discountBoost * 0.8))
  const profitDelta = projectedProfit - baseProfit

  const showWelcomeCard = welcome && !welcomeCardDismissed

  return (
    <main className="flex flex-1 flex-col gap-6">
      {showWelcomeCard ? (
        <WelcomeCard main={welcome.main} sub={welcome.sub} onContinue={() => setWelcomeCardDismissed(true)} />
      ) : (
        <>
      <section className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 className="text-2xl font-semibold tracking-tight text-slate-900 md:text-3xl">
            Growth Command Center – Verma General Center
          </h2>
          <p className="mt-1 max-w-2xl text-base text-slate-700 md:text-lg">
            This dashboard shows how the same &ldquo;life-driven&rdquo; engine can power any neighborhood store –
            today a Kirana in Indore, tomorrow a mithai or garment shop with a different product template.
          </p>
        </div>
        <div className="flex flex-wrap items-center gap-3">
          <button
            type="button"
            onClick={onBackToChat}
            className="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50"
          >
            View onboarding chat
          </button>
          <button
            type="button"
            onClick={onToRajuDay}
            className="rounded-full bg-sahayak-green px-4 py-2 text-xs font-semibold text-slate-950 shadow-md shadow-emerald-500/30 hover:bg-emerald-400"
          >
            Raju&apos;s day →
          </button>
          <div className="flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1">
            <span className="h-2 w-2 rounded-full bg-emerald-600" />
            <span className="text-[0.7rem] font-medium text-emerald-800">
              Connected to AWS · Canvas · Bedrock · DynamoDB
            </span>
          </div>
        </div>
      </section>

      <section className="grid gap-4 md:grid-cols-5">
        <div className="space-y-4 md:col-span-3">
          <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
            <div className="flex items-start justify-between gap-3">
              <div>
                <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">
                  Life-driven alert · Digital Panchang
                </p>
                <h3 className="mt-1 text-lg font-semibold text-slate-900">
                  Festival in 10 days · Mustard Oil Holi in 10 days · Mustard Oil &amp; Ghee demand +40%amp; Ghee demand +40%
                </h3>
                <p className="mt-1 text-xs text-slate-600">
                  Triggered by AWS Systems Manager Change Calendar &amp; EventBridge, powered by SageMaker Canvas
                  time-series.
                </p>
              </div>
              <div className="text-right">
                <p className="text-[0.7rem] uppercase tracking-wide text-slate-500">Confidence</p>
                <p className="text-xl font-semibold text-sahayak-amber">92%</p>
                <p className="mt-0.5 text-[0.65rem] text-slate-500">Professional ML forecast</p>
              </div>
            </div>

            <div className="mt-4 grid gap-3 text-xs text-slate-700 sm:grid-cols-3">
              <div className="rounded-xl bg-slate-50 p-3">
                <p className="text-[0.7rem] uppercase tracking-wide text-slate-500">Mustard Oil</p>
                <p className="mt-1 text-sm font-semibold text-slate-900">40 kg → 56 kg</p>
                <p className="mt-1 text-[0.7rem] text-slate-500">Last festive season vs forecasted demand.</p>
              </div>
              <div className="rounded-xl bg-slate-50 p-3">
                <p className="text-[0.7rem] uppercase tracking-wide text-slate-500">Ghee</p>
                <p className="mt-1 text-sm font-semibold text-slate-900">25 kg → 35 kg</p>
                <p className="mt-1 text-[0.7rem] text-slate-500">Spikes from overlapping wedding season.</p>
              </div>
              <div className="rounded-xl bg-slate-50 p-3">
                <p className="text-[0.7rem] uppercase tracking-wide text-slate-500">Stock today</p>
                <p className="mt-1 text-sm font-semibold text-slate-900">Mustard: 5 kg · Ghee: 4 kg</p>
                <p className="mt-1 text-[0.7rem] text-slate-500">Pulled from DynamoDB inventory snapshot.</p>
              </div>
            </div>
          </div>

          <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 className="text-sm font-semibold text-slate-900">What-if: festival discount strategy</h3>
                <p className="mt-1 text-xs text-slate-600">
                  Slide to test a festive discount and see how volume and profit respond for Mustard Oil + Ghee
                  bundle.
                </p>
              </div>
              <div className="text-right">
                <p className="text-[0.7rem] uppercase tracking-wide text-slate-500">Current discount</p>
                <p className="text-lg font-semibold text-slate-900">{discount}%</p>
              </div>
            </div>

            <div className="mt-4 flex flex-col gap-4 md:flex-row md:items-center">
              <div className="flex-1">
                <input
                  type="range"
                  min={0}
                  max={20}
                  value={discount}
                  onChange={(e) => setDiscount(Number(e.target.value))}
                  className="w-full accent-sahayak-green"
                />
                <div className="mt-1 flex justify-between text-[0.65rem] text-slate-400">
                  <span>0%</span>
                  <span>10%</span>
                  <span>20%</span>
                </div>
              </div>

              <div className="flex-1">
                <div className="flex items-end gap-2">
                  <div className="flex-1">
                    <p className="text-[0.7rem] uppercase tracking-wide text-slate-500">Expected seasonal profit</p>
                    <p className="text-xl font-semibold text-sahayak-green">₹{projectedProfit.toLocaleString('en-IN')}</p>
                  </div>
                  <div className="flex flex-col items-end text-[0.7rem]">
                    <span className="text-slate-500">vs baseline ₹{baseProfit.toLocaleString('en-IN')}</span>
                    <span
                      className={`font-semibold ${
                        profitDelta >= 0 ? 'text-emerald-400' : 'text-rose-400'
                      }`}
                    >
                      {profitDelta >= 0 ? '+' : ''}
                      ₹{profitDelta.toLocaleString('en-IN')}
                    </span>
                  </div>
                </div>

                <button
                  type="button"
                  className="mt-3 inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[0.7rem] font-medium text-slate-700 hover:bg-slate-50"
                >
                  Why is this safe for Raju Bhai?
                </button>
                <p className="mt-2 text-[0.7rem] text-slate-500">
                  In the full build this button calls Amazon Bedrock to explain, in Hinglish, how festival volume
                  and margin math balance out for Kirana, mithai or garment templates.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div className="space-y-4 md:col-span-2">
          <div className="rounded-2xl border border-slate-700 bg-slate-900/85 p-4 md:p-5">
            <h3 className="text-sm font-semibold text-slate-50">Vertical templates</h3>
            <p className="mt-1 text-xs text-slate-300">
              Same engine, different store types. For the hackathon we demo Kirana; the boxes below show how
              quickly we can retarget mithai and garment stores.
            </p>
            <ul className="mt-3 space-y-2 text-xs text-slate-300">
              <li className="flex items-start gap-2">
                <span className="mt-1 h-1.5 w-1.5 rounded-full bg-emerald-400" />
                <span>
                  <span className="font-semibold text-slate-100">Mithai shop:</span> same festive engine, SKUs like
                  gujiya, laddoo, bhujia, box sizes, and shelf-life driven alerts.
                </span>
              </li>
              <li className="flex items-start gap-2">
                <span className="mt-1 h-1.5 w-1.5 rounded-full bg-emerald-400" />
                <span>
                  <span className="font-semibold text-slate-100">Garment store:</span> events become wedding
                  season, Diwali, school reopening; SKUs become sarees, uniforms, kidswear bundles.
                </span>
              </li>
              <li className="flex items-start gap-2">
                <span className="mt-1 h-1.5 w-1.5 rounded-full bg-emerald-400" />
                <span>
                  <span className="font-semibold text-slate-100">Pharmacy pilot:</span> monsoon + pollution
                  alerts for cough syrups, masks, basic antibiotics – with extra safety guardrails.
                </span>
              </li>
            </ul>
          </div>

          <div className="rounded-2xl border border-slate-700 bg-slate-900/85 p-4 md:p-5">
            <h3 className="text-sm font-semibold text-slate-50">Data quality &amp; trust</h3>
            <p className="mt-1 text-xs text-slate-300">
              Judges can inspect how we keep this &ldquo;professional grade&rdquo; – not a random LLM guess.
            </p>
            <dl className="mt-3 space-y-2 text-xs text-slate-300">
              <div className="flex items-start justify-between gap-3">
                <div>
                  <dt className="text-[0.7rem] uppercase tracking-wide text-slate-400">Sales history</dt>
                  <dd className="mt-0.5 font-semibold text-slate-100">sales_history.csv in S3</dd>
                </div>
                <dd className="text-right text-[0.7rem] text-slate-400">
                  Injected festival spikes so Canvas can learn patterns.
                </dd>
              </div>
              <div className="flex items-start justify-between gap-3">
                <div>
                  <dt className="text-[0.7rem] uppercase tracking-wide text-slate-400">Inventory</dt>
                  <dd className="mt-0.5 font-semibold text-slate-100">DynamoDB · per-SKU stock</dd>
                </div>
                <dd className="text-right text-[0.7rem] text-slate-400">
                  Synced from bills, Shelf Eye images and manual edits.
                </dd>
              </div>
              <div className="flex items-start justify-between gap-3">
                <div>
                  <dt className="text-[0.7rem] uppercase tracking-wide text-slate-400">Explainability</dt>
                  <dd className="mt-0.5 font-semibold text-slate-100">Bedrock &ldquo;Why?&rdquo; prompt</dd>
                </div>
                <dd className="text-right text-[0.7rem] text-slate-400">
                  Breaks down units × margin × event boosts in Hinglish.
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </section>
    </>
      )}
    </main>
  )
}

export default App
