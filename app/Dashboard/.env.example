# Friend's Control Centre – copy to .env or .env.local and fill in values.
# Backend (app.py) and Vite both read from .env / .env.local.

# ----- Frontend (Vite) -----
# When running via start.sh: friend's backend runs on port 8001
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# ----- Backend (app.py) – Bedrock / model-status -----
# If these are set here, you do NOT need to export them in the terminal every time.
# IAM user/role must have: bedrock:InvokeModel, bedrock:ListFoundationModels
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_DEFAULT_REGION="ap-south-1"
